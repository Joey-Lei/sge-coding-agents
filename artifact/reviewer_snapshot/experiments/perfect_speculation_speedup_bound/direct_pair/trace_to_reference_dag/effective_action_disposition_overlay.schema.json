{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective_action_disposition_overlay.schema.json",
  "title": "Outcome-adjudicated effective action-disposition overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "scientific_result",
    "case_id",
    "claim_layers",
    "input_bindings",
    "attestations",
    "projected_action_count",
    "stage_b_moved_action_count",
    "rows",
    "counters"
  ],
  "properties": {
    "schema_version": {
      "const": "effective_action_disposition_overlay_v1"
    },
    "status": {
      "const": "materialized_pending_git_freeze_and_independent_verification"
    },
    "scientific_result": {
      "const": false
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_a_mapping",
        "effective_overlay"
      ],
      "properties": {
        "stage_a_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_mode",
            "outcome_adjudicated",
            "duration_visible",
            "mapping_sha256"
          ],
          "properties": {
            "analysis_mode": {
              "const": "duration_outcome_result_blind"
            },
            "outcome_adjudicated": {
              "const": false
            },
            "duration_visible": {
              "const": false
            },
            "mapping_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "effective_overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "analysis_mode",
            "outcome_adjudicated",
            "duration_visible"
          ],
          "properties": {
            "analysis_mode": {
              "const": "outcome_adjudicated_effective_mapping_not_duration_blind"
            },
            "outcome_adjudicated": {
              "const": true
            },
            "duration_visible": {
              "const": false
            }
          }
        }
      }
    },
    "input_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_a_annotation_sha256",
        "stage_a_mapping_sha256",
        "stage_b_response_sha256",
        "stage_b_raw_candidate_sha256",
        "effective_reference_dag_sha256"
      ],
      "properties": {
        "stage_a_annotation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stage_a_mapping_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stage_b_response_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stage_b_raw_candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "effective_reference_dag_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_a_bytes_unchanged",
        "stage_a_mapping_rewritten",
        "effective_overlay_is_outcome_adjudicated",
        "effective_overlay_claimed_duration_blind",
        "duration_not_opened_until_overlay_commit",
        "duration_values_consumed",
        "moved_actions_remain_auditable"
      ],
      "properties": {
        "stage_a_bytes_unchanged": {
          "const": true
        },
        "stage_a_mapping_rewritten": {
          "const": false
        },
        "effective_overlay_is_outcome_adjudicated": {
          "const": true
        },
        "effective_overlay_claimed_duration_blind": {
          "const": false
        },
        "duration_not_opened_until_overlay_commit": {
          "const": true
        },
        "duration_values_consumed": {
          "const": false
        },
        "moved_actions_remain_auditable": {
          "const": true
        }
      }
    },
    "projected_action_count": {
      "type": "integer",
      "minimum": 1
    },
    "stage_b_moved_action_count": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_target_invocations",
        "official_evaluator_invocations",
        "provider_model_invocations",
        "task_originated_network_calls"
      ],
      "properties": {
        "benchmark_target_invocations": {
          "const": 0
        },
        "official_evaluator_invocations": {
          "const": 0
        },
        "provider_model_invocations": {
          "const": 0
        },
        "task_originated_network_calls": {
          "const": 0
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodeDecisionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "decision",
        "envelope_id",
        "stage_b_response_sha256"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "retain",
            "move_to_system_envelope"
          ]
        },
        "envelope_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage_b_response_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projected_action_id",
        "stage_a_disposition",
        "stage_a_semantic_node_ids",
        "effective_disposition",
        "effective_semantic_node_ids",
        "stage_b_node_decision_provenance"
      ],
      "properties": {
        "projected_action_id": {
          "type": "string",
          "minLength": 1
        },
        "stage_a_disposition": {
          "enum": [
            "retain",
            "merge_into_semantic_node",
            "split_across_semantic_nodes",
            "discard_redundant_exploration",
            "discard_tool_noise",
            "move_to_system_envelope"
          ]
        },
        "stage_a_semantic_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effective_disposition": {
          "enum": [
            "retain",
            "merge_into_semantic_node",
            "split_across_semantic_nodes",
            "split_across_effective_semantic_nodes_and_system_envelope",
            "discard_redundant_exploration",
            "discard_tool_noise",
            "move_to_system_envelope"
          ]
        },
        "effective_semantic_node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stage_b_node_decision_provenance": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nodeDecisionProvenance"
          }
        }
      }
    }
  }
}
